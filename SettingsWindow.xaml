<Window x:Class="Paster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        Height="400"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#FFF5F7FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F343A" />
        <SolidColorBrush x:Key="TextMainBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />

        <Style x:Key="SoftTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FFF0F2F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#252A2F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#1E2227" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFE9EDF2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFDDE3EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFD1D8E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ECEFF3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9DEE6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="16"
            Background="{StaticResource WindowBgBrush}"
            BorderBrush="#00000000"
            BorderThickness="0">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="设置"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMainBrush}" />
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="8,0,0,0"
                        ToolTip="关闭"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="clips.json 路径"
                           Margin="2,0,0,6"
                           FontSize="12"
                           Foreground="#996B7280" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathInput"
                             Style="{StaticResource SoftTextBoxStyle}"
                             ToolTip="可填写完整路径，或通过「浏览…」选择" />
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="90"
                            Height="42"
                            Content="浏览…"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseButton_Click" />
                </Grid>
                <TextBlock Margin="2,10,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#996B7280"
                           Text="「保存路径并载入」会写入配置文件并沿用该路径；「仅从文件载入」仅本轮使用，重启后仍为已保存的路径。" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Margin="2,16,0,0"
                          Content="开机时启动"
                          FontSize="13"
                          Foreground="{StaticResource TextMainBrush}"
                          Checked="StartWithWindowsCheckBox_Changed"
                          Unchecked="StartWithWindowsCheckBox_Changed" />
                <TextBlock Margin="24,4,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#996B7280"
                           Text="登录后在托盘运行，不弹出主窗口。" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,20,0,4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button MinWidth="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="仅从文件载入"
                        Click="LoadOnlyButton_Click" />
                <Button MinWidth="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="取消"
                        Click="CancelButton_Click" />
                <Button MinWidth="148"
                        Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="保存路径并载入"
                        Click="SaveApplyButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
